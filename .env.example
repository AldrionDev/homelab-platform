# Copy to .env and fill in real values. Placeholders only — never commit real values.

# Host LAN IPv4 address the platform services bind to.
# Find it with: ip -4 addr
# The placeholder below is RFC 5737 documentation space, not a real host.
HOST_LAN_IP=192.0.2.10

# dnsmasq domain suffix for the home lab (e.g. *.homelab.home.arpa)
HOMELAB_DOMAIN=homelab.home.arpa

# HCP Terraform (remote state, local execution mode)
TF_CLOUD_ORGANIZATION=changeme
TF_WORKSPACE=homelab-platform
