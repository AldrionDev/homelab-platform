# Example environment for backup/backup.sh and backup/restore.sh.
#
# These scripts do NOT auto-load this file. Source it yourself if that's
# convenient, e.g. `set -a; source backup/.env.example; set +a`, or export
# the variables you need through your own tooling.
#
# Every value below is a placeholder. Replace with real, host-specific
# values before use -- never commit real values anywhere in this repo.

# --- backup.sh -------------------------------------------------------

# Required. Must already exist and already be mode 0700. Never created or
# chmod'd by the script.
BACKUP_DESTINATION=/mnt/example-backup-destination

# Required. [A-Za-z0-9-]+ only.
BACKUP_ID=example-workload

# Required. "dir" or "db".
BACKUP_SOURCE_KIND=dir

# Required when BACKUP_SOURCE_KIND=dir. Must already exist.
BACKUP_SOURCE_DIR=/mnt/example-live-data

# Required when BACKUP_SOURCE_KIND=db. Must already exist. Used only as a
# locality safety gate against BACKUP_DESTINATION -- never read, archived,
# or logged.
#BACKUP_LIVE_DATA_PATH=/mnt/example-db-data-directory

# For BACKUP_SOURCE_KIND=db, pass the dump-producer executable and its
# arguments as trailing CLI argv after --, e.g.:
#   BACKUP_DESTINATION=... BACKUP_ID=... BACKUP_SOURCE_KIND=db \
#     BACKUP_LIVE_DATA_PATH=... backup/backup.sh -- /path/to/dump-producer --flag value
#
# The producer is executed directly (argv, no shell string, no eval); its
# stdout becomes the archived dump. Any credentials it needs are its own
# concern (its environment, or a wrapper script you supply) -- never pass
# them as arguments to backup.sh itself.

# Optional, test-only. Must match ^[0-9]{8}T[0-9]{6}Z$ if set.
#BACKUP_TIMESTAMP=20260101T000000Z

# --- restore.sh ------------------------------------------------------

# Required. Path to a previously published archive (its .tar.gz.sha256
# sidecar must exist alongside it).
BACKUP_ARCHIVE=/mnt/example-backup-destination/example-workload-20260101T000000Z.tar.gz

# Required. Must not currently exist as any filesystem object or symlink.
RECOVERY_TARGET=/mnt/example-recovery-target

# Required. Safety-gate only; may currently be absent if the live source
# has already been deleted or corrupted.
RESTORE_LIVE_DATA_PATH=/mnt/example-live-data

# Pass the workload validator executable and its arguments as trailing CLI
# argv after --, e.g.:
#   BACKUP_ARCHIVE=... RECOVERY_TARGET=... RESTORE_LIVE_DATA_PATH=... \
#     backup/restore.sh -- /path/to/validator --flag value
#
# The validator is executed directly against the restored payload path
# (appended automatically as its final argument). Exit 0 = viable,
# non-zero = restore fails and the target is not published as viable.
